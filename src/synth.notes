C 0x5B0F del bit bajo...
C 0x5B14 ...suma DE...
C 0x5B15 ...que se dobla cada vez
C 0x5B1C L = la muestra del oscilador
C 0x5B24 CUT
C 0x5B2B el nivel de la envolvente del DCF...
C 0x5B2E ...por ENV
C 0x5B3D suma, como mucho 0xFF
C 0x5B46 resta, como poco 0
C 0x5B4C LFO del DCF
C 0x5B58 el valor del LFO por LFO del DCF
C 0x5B5E positivo: suma...
C 0x5B67 ...como mucho 0xFF
C 0x5B6C negativo: resta...
C 0x5B74 ...como poco 0
C 0x5B7F extiende el signo
C 0x5B8B la segunda etapa...
C 0x5B8E ...por el corte / 128...
C 0x5B94 ...por la realimentacion
C 0x5B98 sumada a la entrada
C 0x5BA0 x - primera etapa
C 0x5BA9 por (corte + 1) / 256
C 0x5BB1 la primera etapa nueva
C 0x5BB8 x - primera etapa
C 0x5BD2 0xDC3E - segunda etapa
C 0x5BDB por (corte + 1) / 256
C 0x5BE3 la segunda etapa nueva
C 0x5BFC la mitad, con signo
C 0x5C03 la primera etapa
C 0x5C10 el byte bajo
C 0x5C24 8 bits de A
C 0x5C27 DE = el valor
C 0x5C2B negativo: redondea hacia el cero
C 0x5C31 DE a la mitad...
C 0x5C35 ...y por cada bit de A, del alto...
C 0x5C3A ...suma
C 0x5C3E 8 bits de A
C 0x5C41 DE = el valor
C 0x5C45 por cada bit de A, del alto...
C 0x5C4A ...suma...
C 0x5C4B ...y luego DE a la mitad
C 0x5C59 DE = el valor
C 0x5C5D el bit 7...
C 0x5C63 ...vale DE * 2
C 0x5C69 los otros siete
C 0x5C6B del alto...
C 0x5C70 ...suma...
C 0x5C71 ...y luego DE a la mitad
C 0x5C7E la muestra
C 0x5C86 D y C = LFO del DCA
C 0x5C8B el valor del LFO por LFO del DCA
C 0x5C95 la muestra por el factor
C 0x5C98 E = la muestra
C 0x5C99 C = el nivel del DCA
C 0x5C9D 7 bits
C 0x5CA0 E a la mitad, redondeando hacia el cero...
C 0x5CA8 ...y por cada bit del nivel...
C 0x5CAD ...suma
C 0x5CB1 sin LFO, la muestra tal cual
C 0x5CB5 E = el valor con signo
C 0x5CB9 por cada bit de C, del alto...
C 0x5CBE ...suma...
C 0x5CBF ...y E a la mitad con signo
C 0x5CCA la rutina del LFO
C 0x5CCE algun LFO puesto?
C 0x5CDB ninguno: nada
C 0x5CE7 una muestra menos
C 0x5CF0 el valor de la onda en la fase
C 0x5CF4 la retencion otra vez
C 0x5CFD FEET del LFO...
C 0x5D03 ...por 16
C 0x5D13 a la fase
C 0x5D18 la cuenta
C 0x5D21 el ruido, como en 0x5AD4
C 0x5D30 el valor nuevo
C 0x5D33 la retencion otra vez
C 0x5D3B pagina de bucle?
C 0x5D3F no
C 0x5D42 si

