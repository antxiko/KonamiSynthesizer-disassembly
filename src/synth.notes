# ======================================================================
# KONAMI'S SYNTHESIZER (Konami RC-741, 1986) - anotaciones del desensamblado
# ======================================================================
# Formato: ver la cabecera de tools/mkasm.py. Los rangos D son [ini, fin).
#
# Cada directiva D declara un rango de datos con su nombre y la MEDIDA de la
# que sale: el flujo se recorre con tools/flujos.py en el formato del
# descompresor y cierra donde empieza el siguiente, o el codigo dice cuantos
# bytes copia.

# ======================================================================
# LA CABECERA
# ======================================================================
D 0x4000 0x4010 cabecera_del_cartucho  "AB" y la direccion de INIT (0x4054); STATEMENT, DEVICE y TEXT a cero
F 0x4000 w
D 0x4010 0x4012 ceros_tras_la_cabecera  dos ceros antes del `jp` de 0x4012

# INIT copia estos cinco bytes a H.STKE (0xFEDA) y pone el slot del cartucho
# en el segundo: el BASIC acaba de arrancar y salta a 0x406E.
D 0x4069 0x406E gancho_para_h_stke  `rst 0x30`, slot (lo pone INIT), 0x406E y `ret`

# 0x4105 pone en la pagina 2 la RAM del ordenador (el slot que 0x40D4 guarda
# en 0xD854) y 0x410D devuelve el cartucho (0xD855).

# ----------------------------------------------------------------------
# EL ARRANQUE, LA INTERRUPCION Y LOS SLOTS (tanda 1 de comentarios)
# ----------------------------------------------------------------------
L 0x4012 salto_sin_uso  `jp` a 0x455D detras de la cabecera; nadie salta aqui
L 0x4015 interrupcion  la rutina de cada cuadro, por H.KEYI (0xFD9A) desde que 0x4118 acaba
C 0x4015 lee el estado del VDP: lo borra
C 0x4018 y llama el mismo a H.TIMI
C 0x401C los efectos de sonido del PSG, cada cuadro
C 0x401F 0xD805: ocupado (bit 0)
C 0x4024 si el cuadro anterior no ha acabado, solo los efectos
C 0x4026 marca ocupado y deja entrar otra interrupcion
C 0x4028 las teclas
C 0x402B la fase de la pantalla
C 0x402E libre
C 0x4033 si ha llegado otro cuadro mientras tanto (bit 7)...
C 0x4038 ...otra vuelta de los efectos
L 0x403D escribe_registro_vdp  WRTVDP: registro C, valor B
L 0x4040 hl_mas_a  HL = HL + A
L 0x4045 de_mas_a  DE = DE + A
L 0x404A salta_por_tabla  salta a la entrada A de la tabla de palabras que sigue al `call`
C 0x404A HL = la tabla, detras del `call`
C 0x404F DE = la entrada A
C 0x4053 y alli
L 0x4054 init  INIT: la llama la BIOS al encontrar el cartucho; deja el arranque para cuando el BASIC termine
C 0x4054 0xD854/0xD855: los slots de las paginas 2 y 1
C 0x4057 los 5 bytes de 0x4069...
C 0x405A ...a H.STKE (0xFEDA)
C 0x4062 el slot del cartucho...
C 0x4065 ...en el `rst 0x30` del gancho
L 0x406E arranque  el arranque de verdad: H.STKE salta aqui cuando el BASIC ha terminado de arrancar
C 0x406F modo 1: las interrupciones van a 0x0038
C 0x4071 los slots otra vez: ahora la pagina 2 es la RAM del ordenador
C 0x4074 H.KEYI (0xFD9A) = `rst 0x30`...
C 0x4079 ...el slot del cartucho...
C 0x407F ...0x4118...
C 0x4085 ...y `ret`
C 0x408A la pila, bajo 0xDF00
C 0x408D borra las variables, 0xD800-0xDEFF
C 0x409A A = el slot del cartucho...
C 0x409D ...tambien en la pagina 2, donde siguen sus graficos
C 0x40A2 ocupado: la interrupcion no toca nada
C 0x40A7 VDP, PSG y la VRAM en blanco
C 0x40AE la RAM en la pagina 2...
C 0x40B1 ...llena de silencio (0x80)...
C 0x40B4 ...y vuelve el cartucho
C 0x40B7 0xDCFD = 0
C 0x40BB 0xDCFE: el sample mide 1 byte
C 0x40C1 borra el estado del VDP antes de dejar entrar interrupciones
L 0x40C5 bucle_principal  espera a que la pantalla pida trabajo en 0xD8F6 (0x48F0) y llama a 0x4BA1
L 0x40D4 apunta_slots  0xD854 = slot de la pagina 2, 0xD855 = slot de la pagina 1 (el cartucho); vuelve con A = 0xD855
C 0x40D7 A = registro de slots primarios (RSLREG)
C 0x40DB bits 2-3, la pagina 1, a 0-1
C 0x40DD C = slot primario de la pagina 2 y A = su registro secundario
C 0x40E0 el secundario de la pagina 2 a los bits 2-3
C 0x40E2 0xD854
C 0x40E6 la pagina 1
C 0x40E7 C = slot primario y A = secundario de la pagina 1: 0xD855
L 0x40EA guarda_slot  (DE) = C con el secundario de los bits 2-3 de A: el formato de slot de ENASLT
L 0x40EF slot_de_la_pagina  de los bits 2-3 de A: C = slot primario (+0x80 si esta expandido, 0xFCC1) y A = su registro secundario (0xFCC5)
L 0x4105 ram_en_la_pagina_2  pone en 0x8000-0xBFFF la RAM del ordenador: el slot que 0x40D4 guarda en 0xD854
L 0x410D cartucho_en_la_pagina_2  vuelve a poner el cartucho en 0x8000-0xBFFF (0xD855)
L 0x4115 efecto_de_sonido  arranca el efecto A en el PSG (0xBEB1)
L 0x4118 interrupcion_sube_el_dac  la primera rutina de H.KEYI: lleva el DAC de 0 a 0x80 (el reposo) de uno en uno, un paso por interrupcion
C 0x4118 0xD856: el valor que toca (las variables empiezan a 0)
C 0x411C al DAC
C 0x4121 al llegar a 0x80...
C 0x4124 ...H.KEYI pasa a 0x4015
L 0x412B fase_de_pantalla  cada cuadro: 0xD803 cuenta cuadros y salta a la fase 0xD800, con B = el paso 0xD801
C 0x412B 0xD803: contador de cuadros
C 0x4134 en las fases 0, 1 y 2...
C 0x4136 ...vuelve por 0x4242
C 0x413A C = fase (0xD800), B = paso (0xD801)
L 0x4270 prepara_vdp_y_psg  mezclador del PSG, efecto 8, la VRAM a cero y los 8 registros del VDP
L 0x4284 pon_registros_vdp  los 8 registros del VDP de 0x4295, del R0 al R7
L 0x42A2 lee_teclas  0xD807 = teclas pulsadas ahora, 0xD806 = las recien pulsadas
L 0x475A efectos_por_cuadro  los efectos de sonido: R7 = 0xB8 y los tres canales de 0xD810, 5 bytes cada uno
L 0x477D mezclador_psg  R7 del PSG = A (y copia en 0xD81F)
L 0x4E44 llena_de_silencio  0x8000-0xBFFF a 0x80, el reposo del DAC: el sample en blanco

# ======================================================================
# LAS TABLAS DE SALTOS (despachador 0x404A: la tabla va pegada al `call`)
# ======================================================================
D 0x4142 0x4154 saltos_del_arranque  9 destinos por la fase (0xD800); la tabla cierra en 0x4154, su entrada mas baja
F 0x4142 w
D 0x4805 0x4817 saltos_por_pantalla  9 destinos por (0xD8F4), la pantalla en curso; cierra en 0x4817, que llama 0x47F0
F 0x4805 w

# ======================================================================
# GRAFICOS DE LA PRIMERA MITAD
# ======================================================================
D 0x4295 0x429D registros_del_vdp  los 8 registros del VDP, del R0 al R7, que escribe 0x4284: SCREEN 2, colores en 0x0000 y patrones en 0x2000
F 0x4295 2
D 0x4414 0x4536 fuente_rle  la fuente: flujo RLE de 0x4327 hacia 0x2080 (tiles 0x10 en adelante); 0x446E es una segunda entrada en el mismo flujo, desde la A (tile 0x21), que usa 0xB392
D 0x45B9 0x4708 logo_konami_patrones  flujo RLE de 0x4352 hacia 0x2A00: los 120 tiles (20 x 6) del logotipo de Konami
D 0x48F4 0x490B menu_de_abajo_syn  flujo RLE de 0x4352 hacia 0x3AC0: las dos filas de abajo en SYN
D 0x4946 0x494E sprite_cursor  dos sprites de 4 bytes (y, x, patron, color) que copia 0x4922
F 0x4946 4
D 0x4B00 0x4B04 tiles_marcador  dos pares de tiles que escribe 0xBC37 (0x4AED y 0x4AF7)
F 0x4B00 2
D 0x4B2D 0x4BA1 tablas_del_teclado_dibujado  posiciones y tiles de las teclas que se iluminan (0x4A44-0x4B2B)
D 0x4C5B 0x4C89 tablas_del_cursor_syn  tiles del cursor y del marco que lee 0x4BFF-0x4C4E
D 0x4CD4 0x4D04 sprites_de_la_mano  12 sprites de 4 bytes que lee 0x48ED y 0x4CA3
F 0x4CD4 4

# ======================================================================
# FILE: CINTA, DISCO E IMPRESORA
# ======================================================================
D 0x4E7A 0x4E80 direcciones_de_carga  las tres direcciones de RAM donde se carga TONE, LAYOUT y SAMP (0x4E5A, por 0xDB18)
F 0x4E7A w
D 0x4E80 0x4E89 rotulo_found  lista de 0x4337: "FOUND" en 0x3A07
D 0x4FDE 0x4FF4 rotulos_end_y_no_file  "END" y "NO FILE", con los tiles de borde 0x40 y 0x96
D 0x511F 0x512D mensajes_de_disco_punteros  7 punteros a los mensajes de error de disco
F 0x511F w
D 0x512D 0x5191 mensajes_de_disco  7 mensajes acabados en 0xFF: DISK I/O ERROR, FILE NOT FOUND, DISK FULL, DISK NOT READY, WRITE PROTECTED, TOO MANY FILES, BAD FILE NAME
D 0x51D8 0x51DB extension_tks  "TKS", la extension de los ficheros en disco
D 0x534D 0x5361 rotulo_printer_not_ready  lista de 0x4337: "PRINTER NOT READY"
D 0x54B6 0x54E9 ordenes_de_impresora  secuencias ESC de la impresora MSX: ESC T16, ESC S0384, ESC S0768, ESC S0240, ESC A, "TIME" y "WAVE FORM DATA", acabadas en 0xFF
D 0x54F6 0x5516 tramas_de_impresora  32 bytes de tramado que se mandan a la impresora para dibujar la onda

# ======================================================================
# EL MOTOR DE SONIDO
# ======================================================================
D 0x5C12 0x5C1B realimentacion_por_res  la realimentacion del filtro por RES (0xDC05, de 0 a 8): 0x5710 la copia a 0xDC38
D 0x5C1B 0x5C24 ganancia_por_res  la ganancia de salida del filtro por RES (0xDC05): 0x5718 la copia a 0xDC39
D 0x5DA9 0x5E29 teclas_de_fabrica  0x80 bytes que 0x55DC copia a 0xD230: por tecla de la matriz (fila * 8 + bit + 1, 0x5D5D), la rutina y el retardo D de su nota; 0xFFFF sin nota
F 0x5DA9 2
D 0x5E29 0x5E8B rutina_y_retardo_por_nota  las 49 posiciones de 0xBCCA, de FA1 a SI4: rutina (0-12) y retardo D; la muestra dura c(rutina) + 16 * D ciclos. 0xBBDA la copia a la tecla al cambiar la disposicion; 0xFFFF en los huecos sin negra
F 0x5E29 2
D 0x5E8B 0x5EA5 reproduce_con_bucle  13 rutinas de PLAY, el mismo bucle con 67 a 82 ciclos fuera del retardo: el ajuste fino de la afinacion. La nota (0x5E29) elige una y 0x5D9A la carga en IX. Con pagina de bucle (0xDCFD)
F 0x5E8B w
D 0x6709 0x6723 reproduce_sin_bucle  las mismas 13 rutinas para los timbres sin pagina de bucle: suenan hasta 0xC000
F 0x6709 w
D 0x6EBB 0x6ED5 reproduce_samp  las 13 rutinas para la muestra cargada de cinta (SAMP)
F 0x6EBB w
D 0x7135 0x7200 relleno_0x7135  0xFF hasta el principio de las ondas

# Las 14 formas de onda de fabrica, 256 bytes con signo cada una: la onda n
# esta en la pagina 0x72 + n (0x56FF y 0x573F). La 14 no esta aqui: es una de
# las 16 ondas del usuario, en la RAM de 0xC000.
D 0x7200 0x7300 onda_00  seno
F 0x7200 16
D 0x7300 0x7400 onda_01  sierra descendente
F 0x7300 16
D 0x7400 0x7500 onda_02  sierra ascendente
F 0x7400 16
D 0x7500 0x7600 onda_03  cuadrada
F 0x7500 16
D 0x7600 0x7700 onda_04  pulso
F 0x7600 16
D 0x7700 0x7800 onda_05  onda muestreada
F 0x7700 16
D 0x7800 0x7900 onda_06  onda muestreada
F 0x7800 16
D 0x7900 0x7A00 onda_07  onda muestreada
F 0x7900 16
D 0x7A00 0x7B00 onda_08  onda muestreada
F 0x7A00 16
D 0x7B00 0x7C00 onda_09  onda muestreada
F 0x7B00 16
D 0x7C00 0x7D00 onda_10  onda muestreada
F 0x7C00 16
D 0x7D00 0x7E00 onda_11  onda muestreada
F 0x7D00 16
D 0x7E00 0x7F00 onda_12  onda muestreada
F 0x7E00 16
D 0x7F00 0x8000 onda_13  onda muestreada
F 0x7F00 16

# ======================================================================
# LOS GRAFICOS DE LA PAGINA 2 (se lee con la ROM puesta en 0x8000)
# ======================================================================
# Con R3 = 0x7F y R4 = 0x07 los COLORES van en 0x0000 y los PATRONES en
# 0x2000, al reves de lo habitual. Todos encadenados: cada flujo acaba (tools/flujos.py) donde empieza el
# siguiente, sin un byte suelto.
D 0x8000 0x82A5 sprites_patrones  flujo RLE de 0x4352 hacia 0x1800 (0x43A1): los patrones de los sprites de 16x16
D 0x82A5 0x84EB marco_patrones  flujo RLE de 0x4327 hacia 0x2200: patrones del marco comun
D 0x84EB 0x8531 marco_colores_1  flujo RLE de 0x4327 hacia 0x0008
D 0x8531 0x8552 marco_colores_2  flujo RLE de 0x4327 hacia 0x00D8
D 0x8552 0x874D marco_colores_3  flujo RLE de 0x4327 hacia 0x01D8
D 0x874D 0x8799 wave_edit_1  flujo RLE de 0x4352 (WAVE EDIT, 0xB02A)
D 0x8799 0x87A0 wave_edit_2  flujo RLE de 0x4352 (0xB030)
D 0x87A0 0x87DB wave_edit_3  flujo RLE de 0x4352 (0xB036)
D 0x87DB 0x8815 cabecera_nombres  flujo RLE de 0x4352 hacia 0x3800: la franja de arriba de las pantallas de edicion
D 0x8815 0x8A41 wave_edit_nombres  flujo RLE de 0x4352 hacia 0x3860 (0xB052)
D 0x8A41 0x8A81 menu_de_abajo_a  0x40 bytes de la tabla de nombres que 0x48C4 copia a 0x3AC0: las dos filas de abajo, TONE-E WAVE-E SYN PLAY FILE
D 0x8A81 0x8AC1 menu_de_abajo_b  la otra variante, por (0xD8F0)
D 0x8AC1 0x8DB6 tone_edit_patrones  flujo RLE de 0x4327 hacia 0x2458
D 0x8DB6 0x8FCD tone_edit_colores  flujo RLE de 0x4327 hacia 0x0458
D 0x8FCD 0x9087 tone_edit_extra  flujo RLE de 0x4352 hacia 0x2900
D 0x9087 0x925A tone_edit_nombres  flujo RLE de 0x4352 hacia 0x3860
D 0x925A 0x92F4 teclado_patrones_1  flujo RLE de 0x4327 hacia 0x2080 (SYN y PLAY)
D 0x92F4 0x9559 teclado_patrones_2  flujo RLE de 0x4327 hacia 0x2458
D 0x9559 0x95EA teclado_colores_1  flujo RLE de 0x4327 hacia 0x0080
D 0x95EA 0x97FD teclado_colores_2  flujo RLE de 0x4327 hacia 0x0458
D 0x97FD 0x98DF rotulos_internacionales_patrones  flujo RLE de 0x4327 hacia 0x2600: solo si (0x002C) & 0x0F no es cero, o sea en un MSX que no es japones
D 0x98DF 0x9988 rotulos_internacionales_colores  flujo RLE de 0x4327 hacia 0x0600: lo mismo
D 0x9988 0x9AC5 teclado_nombres  flujo RLE de 0x4352 hacia 0x3800
D 0x9AC5 0x9C63 file_patrones  flujo RLE de 0x4327 hacia 0x2458
D 0x9C63 0x9D74 file_colores  flujo RLE de 0x4327 hacia 0x0458
D 0x9D74 0x9E37 file_nombres  flujo RLE de 0x4352 hacia 0x3860
D 0x9E37 0x9E87 digitos_patrones  0x50 bytes que 0xB34A copia a 0x2080 en los tres tercios: los patrones de los diez digitos (tiles 0x10-0x19)
D 0x9E87 0x9E8F rotulo_colores_a  8 bytes de color que 0xB363 copia a los diez digitos (TONE EDIT)
D 0x9E8F 0x9E97 rotulo_colores_b  8 bytes de color para las demas pantallas
D 0x9E97 0xA2BF titulo_patrones  0x428 bytes de patrones del logotipo 新世SIZER: 0x4708 los copia de golpe a 0x2200 y 0x418A de byte en byte, que es la animacion de la pincelada
D 0xA2BF 0xA2E5 titulo_colores  flujo RLE de 0x4327 hacia 0x0200, los colores del logotipo
D 0xA2E5 0xA3AA titulo_nombres_logo  flujo RLE de 0x4352 hacia 0x3840

# Los 16 timbres de fabrica: 0x55BC copia los 0x200 bytes a 0xD000.
D 0xA3AA 0xA5AA timbres_de_fabrica  16 timbres de 32 bytes: parametros y nombre de 8 letras (0x21 = A, 0x41 = 1)
F 0xA3AA 24,8

# ======================================================================
# DATOS DE LA SEGUNDA MITAD DEL CODIGO
# ======================================================================
D 0xA92A 0xA92D tiles_flecha  3 tiles que copia 0xA928
D 0xA947 0xA94C limites_del_cursor  4 valores acabados en 0xFF (0xA932)
D 0xA98B 0xAA5B tablas_de_tone_edit  posiciones y valores de los campos de TONE EDIT (0xA5F5-0xAB1F)
D 0xAB31 0xAB58 tablas_de_tone_edit_2  lo que leen 0xAA67-0xAB14
D 0xABD8 0xAC08 tiles_de_los_conmutadores  tiles de los conmutadores dibujados (0xABCC)
D 0xAC12 0xACDA tablas_de_campos  0xACE0, 0xA5EF y 0xA5FC
D 0xAEDD 0xAEE1 bits_80_40_20_10  mascaras de bit que lee 0xAED9
D 0xB1CD 0xB1E8 tablas_de_wave_edit  lo que leen 0xB016-0xB12A
D 0xB555 0xB5C8 tablas_de_file  listas de 0x4337 y RLE de FILE MODE (0xB494-0xB4F6)
D 0xB729 0xB76E tablas_del_menu_file  posiciones y flujos RLE cortos del menu de FILE (0xB67E-0xB728)
D 0xB832 0xB834 dos_bytes_0xB832  0xA8 0xD9 delante del codigo que nadie llama de 0xB834
D 0xB841 0xB851 file_flecha  flujo RLE de 0x4352 (0xB7B6)
D 0xBA6C 0xBB6D listas_de_file  listas de 0x4337 del menu de cinta y disco (0xB88E-0xBA66)
D 0xBCB6 0xBCBD lista_0xBCB6  6 valores acabados en 0xFF que recorre 0xBCA2
D 0xBCCA 0xBCFB notas_del_teclado  nota -> tecla dibujada, que recorre 0x49A3
F 0xBCCA 2
D 0xBD55 0xBE41 tablas_del_teclado  lo que leen 0xBC0B-0xBC49
D 0xBE5E 0xBE62 pantalla_inicial  0, 1, 3 y 6: la pantalla con que se arranca, por (0xD80B) & 3
D 0xBE75 0xBEA6 rotulo_push_space_key  lista de 0x4337 hacia 0x3A29: "PUSH SPACE KEY" y "(C)KONAMI 1986"; 0xBE84 es la segunda linea, que parpadea
D 0xBF00 0xC000 tablas_del_final  punteros y datos que leen 0x4793-0x47AC y 0xBEF5-0xBEF9

# ----------------------------------------------------------------------
# SYN: EL MOTOR QUE FABRICA LA ONDA (tanda 2 de comentarios; tools/motor.py
# lo reproduce byte a byte en los 16 timbres)
# El timbre en 0xDC00-0xDC18: 0 onda, 1 FEET del DCO, 2 LFO del DCO, 3 ENV del
# DCO, 4 CUT, 5 RES, 6 LFO del DCF, 7 ENV del DCF, 8 LFO del DCA, 9-12 ADSR
# del DCO, 13-16 ADSR del DCF, 17-20 ADSR del DCA, 21 retencion del LFO,
# 22 onda del LFO, 23 FEET del LFO, 24 conmutadores.
# 0xDC1B: bit 0 DCO en su sostenido, bit 1 DCF, bit 2 DCA, bit 7 se acabo.
# ----------------------------------------------------------------------
B 0x55E8 =====  SYN: la sintesis del timbre en la RAM de 0x8000  =====
L 0x55E8 tic_de_sintesis  cada 0xDC22 muestras: 0x4BD9 y 0xDC24 + 1
L 0x55F0 syn  SYN: fabrica el timbre de 0xDC00 muestra a muestra en 0x8000-0xBFFF, la RAM del ordenador
C 0x55F2 0xDC24 = 0
C 0x55F5 la RAM en 0x8000
C 0x55F8 ENV del DCO a cero: su envolvente no cuenta
C 0x5605 B, C, A = ataque, caida y sostenido del DCO
C 0x5610 HL = muestras de ataque y caida
C 0x5613 0xDC1C: las del DCO
C 0x5617 16 KB o mas: no se calcula
C 0x561C ENV del DCF a cero: no cuenta
C 0x5629 ataque, caida y sostenido del DCF
C 0x5637 0xDC1E: las del DCF
C 0x5640 ataque, caida y sostenido del DCA
C 0x564E 0xDC20: las del DCA
C 0x5657 la mayor de las tres...
C 0x5676 ...redondeada a pagina entera
C 0x567E mas la relajacion del DCA: sostenido x R
C 0x568B mas 0x40
C 0x5695 si pasa de 16 KB, 0x80
C 0x569A 0xDC22 = la duracion calculada / 128
C 0x56A2 0xDC23: cuenta atras hasta el siguiente tic
C 0x56A6 0xDCFD: sin pagina de bucle
C 0x56A9 el sample entero a 0x80, el silencio
C 0x56B5 0xDC19: el puntero de escritura, desde 0x8000
C 0x56BB 0xDC1B: ninguna envolvente en su sostenido
C 0x56BF las tres envolventes empiezan por el ataque: rutina, cuenta 1 y nivel 0
C 0x56E9 0xDC31: la fase del oscilador
C 0x56EF la onda 14 es la del usuario...
C 0x56F7 ...en 0xC000 + 0x100 * (0xDB00)
C 0x56FF las de la ROM, en la pagina 0x72 + onda
C 0x5701 0xDC33: la pagina de la onda
C 0x5704 0xDC35: el puntero del ruido, de 0x0000 en adelante
C 0x570A RES...
C 0x5715 ...da la realimentacion (0xDC38)...
C 0x571D ...y la ganancia (0xDC39)
C 0x5720 los estados del filtro a cero
C 0x5729 0xDC42: la fase del LFO
C 0x572F la onda del LFO, igual que la del DCO
C 0x5741 0xDC44
C 0x5745 0xDC46: la cuenta de la retencion
C 0x5748 si algun LFO esta puesto (DCO, DCF o DCA)...
C 0x5758 ...0xDC40 = 0x5CCE
C 0x5761 si no, 0x5D39 (un `ret`)
L 0x5767 bucle_de_sintesis  una muestra por vuelta, hasta 0xC000 o el fin de la envolvente del DCA
C 0x5767 fila 6 del teclado
C 0x5770 F1 o F2 cortan la sintesis
C 0x577B fila 7
C 0x577D F4 o F5 tambien
C 0x5786 0xDC23: el tic, cada 0xDC22 muestras
C 0x5796 el LFO
C 0x5799 la envolvente del DCO
C 0x579C la del DCF
C 0x579F la del DCA
C 0x57A2 el oscilador: la muestra
C 0x57A5 el filtro
C 0x57A8 la amplitud
C 0x57AB con signo a 0x80 = cero...
C 0x57B0 ...a la RAM
C 0x57B6 la memoria llena: se acabo
C 0x57BB la envolvente del DCA ha acabado (bit 7)?
L 0x57C3 fin_de_sintesis  0xDCFE = bytes escritos; 0xDC47 = 0x39, el codigo de F4; vuelve el cartucho
C 0x57CD 0xDCFE: la longitud del sample
L 0x57D9 syn_cortado_fila_6  F1 (0x36) o F2 (0x37) a 0xDC47
L 0x57E8 syn_cortado_fila_7  F4 (0x39) o F5 (0x3A) a 0xDC47
L 0x57F7 muestras_ataque_y_caida  HL = B * 255 + C * (255 - A): ataque B, caida C, sostenido A
L 0x5812 multiplica_c_por_e  HL = C * E
L 0x5825 envolvente_dco  salta a la fase en curso (0xDC25); cuenta en 0xDC27, nivel en 0xDC28
L 0x5829 dco_ataque  sube el nivel de 1 en 1 cada A muestras hasta 0xFF; con A = 0, de golpe
C 0x5829 sin ENV del DCO no hay envolvente:
C 0x5830 marca el sostenido y acaba
C 0x5849 carga 0x584C en HL y no lo guarda: la fase sigue en 0x5829, que vuelve aqui cada muestra
L 0x5862 dco_caida  baja el nivel cada D muestras hasta S; con D = 0 o S = 0xFF, de golpe
L 0x588D dco_llega_al_sostenido  bit 0 de 0xDC1B; con S = 0 la envolvente acaba
L 0x58A3 dco_sostenido  espera a que las tres envolventes esten en su sostenido (0xDC1B = 7)
L 0x58BC dco_relajacion  baja el nivel cada R muestras hasta 0
L 0x58CA dco_fin  la fase pasa a un `ret`
L 0x58D1 envolvente_dcf  la misma maquina para el DCF: fase en 0xDC29, cuenta 0xDC2B, nivel 0xDC2C
L 0x58D5 dcf_ataque  como 0x5829, con ENV del DCF y bit 1
C 0x58F5 como en 0x5849: HL sin guardar
L 0x590E dcf_caida  como 0x5862
L 0x5939 dcf_llega_al_sostenido  bit 1 de 0xDC1B
L 0x594F dcf_sostenido  como 0x58A3
L 0x5968 dcf_relajacion  como 0x58BC
L 0x5976 dcf_fin  la fase pasa a un `ret`
L 0x597D envolvente_dca  la del volumen: fase en 0xDC2D, cuenta 0xDC2F, nivel 0xDC30
L 0x5981 dca_ataque  como 0x5829, sin poder apagarse
C 0x598F como en 0x5849: HL sin guardar
L 0x59A8 dca_caida  como 0x5862
L 0x59D3 dca_llega_al_sostenido  pasa a 0x59D9
L 0x59D9 dca_sostenido  con el DCO y el DCF en su sostenido y el puntero a principio de pagina, apunta esa pagina en 0xDCFD
C 0x59D9 DCO y DCF en su sostenido?
C 0x59DF el puntero a principio de pagina?
C 0x59E4 EG TYP (bit 7 de los conmutadores): sin bucle
C 0x59EC ni en la ultima pagina
C 0x59F4 0xDCFD: la pagina que PLAY repite mientras se tiene la tecla
L 0x59FE dca_espera_pagina  en el siguiente principio de pagina empieza la relajacion
C 0x5A03 bit 2: el DCA en su sostenido
C 0x5A0B S = 0: acaba ya
L 0x5A25 dca_relajacion  como 0x58BC
L 0x5A33 dca_fin  bit 7 de 0xDC1B: la sintesis acaba
L 0x5A3C multiplica_8  A = suma de E >> k por cada bit de C, del 7 al 0
L 0x5A4B oscilador  devuelve en A la muestra de la onda en la fase 0xDC31 y avanza la fase
C 0x5A4B la onda 15 o mas: ruido
C 0x5A53 la muestra en la fase
C 0x5A58 sin LFO del DCO, el paso es FEET * 256
C 0x5A68 con LFO: el paso, FEET por 1 + LFO
C 0x5A6C el LFO negativo...
C 0x5A81 ...resta: 1 - LFO / 2
C 0x5A98 HL = FEET por el factor
C 0x5A9B y si hay ENV del DCO...
C 0x5AA4 ...por el nivel de su envolvente
C 0x5AAD invertida con el bit 3 de los conmutadores
C 0x5ACA la fase avanza el paso
L 0x5AD4 ruido  lee la memoria de 0x0000 en adelante (la BIOS) con 0xDC35, girada y acumulada en 0xDC34
L 0x5AE4 multiplica_16  HL = suma de DE >> k por cada bit de C, del 7 al 0
L 0x5AF6 multiplica_8_8  HL (8.8) por DE: la parte baja contra DE a la derecha, la alta contra DE a la izquierda
L 0x5B1C filtro  filtro de dos etapas con resonancia sobre la muestra L; devuelve A
C 0x5B1D sin ENV del DCF, el corte es CUT
C 0x5B2A con ENV: CUT mas o menos ENV por el nivel de su envolvente
C 0x5B32 bit 2 de los conmutadores: resta
C 0x5B4B y el LFO del DCF lo mueve arriba o abajo
C 0x5B75 0xDC37: el corte
C 0x5B78 la muestra con signo a 16 bits
C 0x5B80 con realimentacion...
C 0x5B88 ...mas la salida de la segunda etapa por corte y realimentacion
C 0x5B99 la primera etapa: 0xDC3A += (x - 0xDC3A) * (corte + 1) / 256
C 0x5BA5 con corte 0xFF no multiplica
C 0x5BB4 0xDC3E: lo que queda, x - 0xDC3A
C 0x5BBD la segunda etapa solo con el bit 0 o con realimentacion
C 0x5BCC 0xDC3C += (0xDC3E - 0xDC3C) * (corte + 1) / 256
C 0x5BE6 la salida: bit 0, la segunda etapa...
C 0x5BEE ...bit 1, la primera...
C 0x5BF3 ...y si no, 0xDC3E / 2
C 0x5C06 por la ganancia de RES
L 0x5C24 por_a_entre_256  HL con signo por A / 256: primero la mitad, luego suma
L 0x5C3E por_a_entre_128  HL con signo por A / 128: suma antes de dividir
L 0x5C58 por_a_bit7_doble  como 0x5C3E, con el bit 7 de A valiendo el doble
L 0x5C7E amplitud  la muestra por el LFO del DCA y por el nivel de la envolvente del DCA
C 0x5C7F sin LFO del DCA, directo al volumen
C 0x5C88 el factor: 0x80 - LFO + LFO por la onda del LFO
L 0x5C98 por_el_dca  A = E con signo por el nivel 0xDC30 / 128
L 0x5CB5 multiplica_con_signo  A = suma de E >> k (E con signo) por cada bit de C
L 0x5CCA lfo  salta por 0xDC40: 0x5CCE o 0x5D39
L 0x5CCE lfo_paso  cada (retencion + 1) muestras toma el valor de la onda del LFO; la fase avanza FEET * 16
C 0x5CDC onda 15 o mas: muestreo y retencion
C 0x5CE4 0xDC46: la cuenta de la retencion
C 0x5CED se acabo la cuenta: el valor nuevo, 0xDC45
C 0x5CFA la fase del LFO avanza FEET del LFO * 16
L 0x5D18 lfo_ruido  muestreo y retencion: el valor nuevo sale del ruido (como 0x5AD4)
L 0x5D39 lfo_apagado  sin LFO: nada
L 0x5D3A play  PLAY: sin pagina de bucle (0xDCFD = 0) las rutinas de 0x6709; con bucle, las de 0x5E8B

# ----------------------------------------------------------------------
# LA INTRO: FASES 0xD800 / PASOS 0xD801 (tanda 3)
# Fase 0: logotipo de Konami y el 新世SIZER; 1: el titulo esperando; 2: la
# cortina y vuelta a empezar; 3: ESPACIO pulsado, parpadeo; 4 y 5: al
# programa. El paso va en B y se reparte con `djnz`: el paso 0 es el ultimo
# destino de la cadena.
# ----------------------------------------------------------------------
L 0x4154 fase_0  paso 1: la cortina del logotipo de Konami, un tramo cada dos cuadros
C 0x4154 paso 1 aqui; los demas, mas abajo
C 0x4156 cuadros impares nada
C 0x415B la cortina; Z al acabar las seis filas
C 0x415F 0xD804 = 0 y el paso siguiente
L 0x4163 fase_0_paso_2  espera 256 cuadros y prepara el logotipo 新世SIZER
C 0x4165 0xD804: cuenta atras
C 0x416A colores del logotipo y pantalla
C 0x416D sus patrones, 0x428 bytes desde 0x2200...
C 0x4173 ...a 0xFF en los tres tercios
C 0x4178 la tabla de nombres del logotipo
C 0x417B siete pasadas de pincel
L 0x4182 fase_0_paso_3  cada 16 cuadros una pasada de pincel: los patrones de 0x9E97, de ocho en ocho
C 0x4184 solo uno de cada 16 cuadros
C 0x418A destino: los patrones de 0x2200...
C 0x418D ...origen: 0x9E97...
C 0x4190 ...los dos mas la pasada (0xD910)
C 0x419B 0x85 bytes, uno de cada ocho
C 0x419F un byte...
C 0x41A4 ...en los tres tercios
C 0x41A9 ocho mas alla
C 0x41B6 la pasada siguiente
C 0x41BA quedan pasadas
C 0x41BB el rotulo de 0xBE75
C 0x41C1 fase 1 con 0xD804 = 0
L 0x41C5 fase_0_paso_0  registros del VDP, pantalla en blanco, la fuente y el logotipo de Konami
C 0x41C5 los 8 registros
C 0x41C8 sprites fuera y nombres a cero
C 0x41CB la fuente
C 0x41CE el logotipo de Konami
L 0x41D3 fase_1  el titulo: espera 256 cuadros y pasa a la fase 2
L 0x41DB fase_2  paso 1: espera a 0xD863 y vuelve a la fase 0
C 0x41DD 0xBE62
C 0x41E0 0xD863 sin acabar: espera
C 0x41E5 otra vez el logotipo de Konami
L 0x41F0 fase_2_paso_0  la cortina que borra la tabla de nombres, columna a columna
C 0x41F0 una columna; P mientras quedan
C 0x41F4 0xBE41
L 0x41F9 siguiente_paso_con_cuenta  0xD804 = A y 0xD801 + 1
L 0x41FC siguiente_paso  0xD801 + 1
L 0x4201 fase_3  paso 1: la segunda linea del rotulo (0xBE84) parpadea, 4 cuadros escrita y 4 borrada
C 0x4206 bit 2 de la cuenta:
C 0x420D escrita...
C 0x4212 ...o borrada
C 0x4215 0x50 cuadros
L 0x421C fase_3_paso_2  prepara el programa y pasa a la fase 4
L 0x4223 fase_3_paso_0  0xD804 = 0x50 cuadros de parpadeo
L 0x4227 fase_4  paso 1: a la fase 5
L 0x4229 siguiente_fase  0xD804 = 0x20
L 0x422B siguiente_fase_con_cuenta  0xD804 = A, 0xD800 + 1 y el paso a 0
L 0x4232 paso_0  0xD801 = 0
L 0x4237 fase_4_paso_0  0xD804 = 0x78
L 0x423F fase_5  el programa (0x47DB)
L 0x4242 tecla_en_la_intro  tras las fases 0-2: una tecla salta al titulo, y ESPACIO o SELECT en el titulo arrancan
C 0x4242 el byte de teclas
C 0x4245 0xD852 ahora, 0xD851 las recien pulsadas
C 0x424C ninguna nueva: nada
C 0x424D 0xD804 = 0
C 0x4255 B = la fase
C 0x4256 en la fase 1 (el titulo)...
C 0x4258 ...ESPACIO o SELECT (bits 4 y 5)...
C 0x425B ...0xD802 = 0x40...
C 0x4260 ...fase 3, paso 0
C 0x4266 en las fases 0 y 2: al titulo (fase 1)...
C 0x4268 ...con el efecto 8...
C 0x426D ...y el logotipo entero de golpe
C 0x4270 R7 del PSG = 0xB8: los tres canales de tono
C 0x4275 el efecto 8
C 0x427A los 16 KB de la VRAM a cero
C 0x4284 desde 0x4295...
C 0x4287 ...8 registros, del R0
C 0x428C WRTVDP: registro C, valor B
L 0x429D color_de_borde  R7 del VDP = B
C 0x42A2 A = el byte de teclas
C 0x42A5 0xD807 las de ahora, 0xD806 las recien pulsadas
L 0x42A8 flancos  (HL) = A; (HL - 1) = las que no estaban antes; vuelve con ellas en A
C 0x42A8 las de antes
C 0x42AA las que han cambiado...
C 0x42AB ...y estan pulsadas
C 0x42AF 0xD8FF
L 0x42B7 byte_de_teclas  bit 0 arriba, 1 abajo, 2 izquierda, 3 derecha, 4 ESPACIO, 5 SELECT
C 0x42B7 fila 7
C 0x42BC SELECT (bit 6) al bit 5
C 0x42C1 fila 8
C 0x42C6 izquierda (bit 4) al bit 2
C 0x42CE derecha y ESPACIO a los bits 3 y 4
C 0x42D6 arriba y abajo a los bits 0 y 1
L 0x42DC limpia_pantalla  sprites fuera y la tabla de nombres (0x3800) a cero
C 0x42DC sprites fuera
C 0x42DF 0x300 nombres a cero
L 0x42E9 vram_escribe_desde  SETWRT en HL y en C' el puerto de escritura del VDP (0x0007)
C 0x42EA SETWRT
C 0x42EE el puerto de la BIOS
L 0x42F5 vram_lee_desde  SETRD en HL y en C' el puerto de lectura del VDP (0x0006)
L 0x42FF copia_a_vram  LDIRVM de DE a la VRAM de HL, BC bytes
L 0x4303 copia_a_vram_x3  lo mismo en los tres tercios de la pantalla (0x800 de distancia)
C 0x4309 un tercio
C 0x430C el siguiente
L 0x4316 rellena_vram_x3  FILVRM de A en HL, BC bytes, en los tres tercios
C 0x431A un tercio
C 0x431D el siguiente
L 0x4327 rle_a_vram_x3  el flujo RLE de DE en HL, en los tres tercios
C 0x432B un tercio
C 0x432E el siguiente
L 0x4337 escribe_lista  escribe la lista de DE: palabra = direccion de VRAM, bytes hasta 0xFF; 0xFE trae otra direccion
L 0x4339 escribe_lista_and_c  la lista con cada byte AND C (C = 0: la borra)
C 0x4339 HL = la direccion...
C 0x433E ...DE = el primer byte
C 0x433F el byte
C 0x4342 0xFF: se acabo
C 0x4344 0xFE: otra direccion
C 0x4347 AND C...
C 0x4348 ...a la VRAM
L 0x434E borra_lista  la lista de DE con ceros
L 0x4352 rle_a_vram  el flujo RLE de DE: palabra = direccion de VRAM y luego los tramos
C 0x4352 HL = la direccion
L 0x4358 rle_a_vram_en_hl  los tramos desde HL: n < 0x80 repite el byte siguiente n veces, 0x80 + n copia n bytes, 0x80 trae otra direccion, 0 acaba
C 0x435B el byte de control
C 0x435C 0: se acabo
C 0x4360 bit 7 a cero:
C 0x4363 repeticion
C 0x4365 0x80:
C 0x4366 otra direccion
C 0x4368 0x80 + n: n bytes tal cual
C 0x436C al VDP
C 0x4373 el byte que se repite
C 0x4376 al VDP
L 0x437D prepara_el_programa  al salir del titulo: borra la RAM del programa, mira si hay disco, copia timbres y ondas de fabrica y trae los sprites
C 0x437D 0xC000-0xD7FF a cero: ondas, timbres, LAYOUT
C 0x4386 0xD856-0xDBFF a cero
C 0x438F H.PHYD (0xFFA7) todavia `ret`...
C 0x4396 ...no hay disco: 0xD9DE = 1
C 0x439B los 16 timbres de fabrica y las ondas
C 0x439E 0x4B21
C 0x43A1 los patrones de los sprites (0x8000)
L 0x43A8 borra_memoria  HL a HL + BC a cero
L 0x43B0 cortina_de_salida  borra una columna de la tabla de nombres por cuadro; M al acabar
C 0x43B0 la columna, contando hacia atras
C 0x43B5 0x3800 + (columna XOR 0x1F)
C 0x43BD las 24 filas...
C 0x43C0 ...de 32 en 32
L 0x43C9 sprites_fuera  la copia de los atributos (0xD870) a cero y 0xD0 en 0x3B00: no se ve ninguno
C 0x43C9 0xD870-0xD8EF a cero
C 0x43D2 0xD0 en el primer sprite: corta la lista
L 0x43DC cifras  B cifras de DE hacia la izquierda desde HL, dos por byte (BCD), tile 0x10 + cifra
L 0x43E0 cifras_40  igual con el tile 0x40 + cifra
C 0x43E2 la cifra baja
C 0x43E9 B cifras
C 0x43EC la alta
C 0x43F3 la alta siempre con 0x10
L 0x43FD fuente  los tiles 0-15 a cero, la fuente de 0x4414 desde el tile 0x10 y su color 0xF0
C 0x43FD los tiles 0-15
C 0x4400 la fuente, patrones desde 0x2080
C 0x4409 su color, blanco sobre negro
L 0x4536 tiles_0_15  patrones de los tiles 0-15 a cero y sus colores 0x00, 0x01... uno por tile
C 0x4536 patrones a cero
C 0x4540 los colores: 16 tiles de 8 bytes
C 0x4552 el siguiente color
L 0x4557 logo_konami  el logotipo de Konami: 0xD80E = 0 para su cortina
L 0x455D logo_konami_tiles  los 120 tiles del logotipo (0x45B9), su color a cero y 20 x 6 nombres seguidos desde el 0x40
C 0x455D los patrones
C 0x4563 los colores a cero: no se ve
C 0x456D en la tabla de nombres, desde 0x3907...
C 0x4570 ...los tiles 0x40 en adelante...
C 0x4572 ...6 filas...
C 0x4577 ...de 20
C 0x4580 la fila siguiente
L 0x4585 cortina_logo_konami  pinta 0xF0 en una linea de los 20 tiles de la fila 0xD80F; Z al acabar las seis filas
C 0x4585 C = linea, B = fila
C 0x4589 A = 20 * fila
C 0x4590 por 8, desde los colores 0x0A00
C 0x4599 mas la linea
C 0x459D 20 tiles...
C 0x45A2 ...en blanco sobre negro
C 0x45AA la linea siguiente
C 0x45B3 y la fila
C 0x45B6 6 filas

# ----------------------------------------------------------------------
# EL PROGRAMA: PANTALLAS, TECLADO, EFECTOS DEL PSG (tanda 4)
# 0xD8F4 = la pantalla (tabla 0x4805): F1-F5 dan 0-4 y, con la segunda pagina
# del menu (0xD8F0, SHIFT), 5-8. 0xD802 bit 6: el programa en marcha.
# ----------------------------------------------------------------------
L 0x4708 logo_sizer_entero  los patrones del logotipo 新世SIZER (0x9E97) de una vez
C 0x4708 0x428 bytes de 0x9E97...
C 0x470B ...a los patrones de 0x2200
L 0x4714 logo_sizer_pantalla  borde 0xE0, pantalla limpia, la fuente y los colores del logotipo (0xA2BF)
C 0x4714 R7 = 0xE0
C 0x471F 0x70 en los colores de la zona del logotipo
C 0x4733 y 0xE0 en otra franja
C 0x473E los colores del logotipo, en RLE
L 0x4747 titulo_de_golpe  el logotipo entero, sus nombres y el rotulo, sin pinceladas
C 0x474D el rotulo de 0xBE75
L 0x4754 logo_sizer_nombres  la tabla de nombres del logotipo (0xA2E5)
C 0x4761 C = 1: el registro de tono grueso del canal A
C 0x4763 los tres canales, 5 bytes cada uno
C 0x476E (IX+2): canal activo
C 0x4775 los registros del canal siguiente
L 0x4786 efecto_canal  un canal: cuando acaba la cuenta (IX+0), la nota siguiente de la lista (IX+3)
C 0x4789 la cuenta de la nota
C 0x478D HL = la lista
C 0x4794 0xFF: se acabo
C 0x4798 0x2n: n = duracion de las notas (IX+1)
C 0x47A5 alto: volumen; bajo: tono grueso...
C 0x47AC ...y el byte siguiente, el fino
C 0x47AE la lista avanza
C 0x47B5 tono grueso en el registro C
C 0x47BA y el fino en C - 1
C 0x47C0 el volumen al nibble bajo
C 0x47C6 la cuenta, otra vez la duracion
L 0x47CE efecto_acabado  canal inactivo y volumen a cero
L 0x47D3 volumen_del_canal  registro 8 + C / 2 = H
C 0x47D4 C = 1, 3, 5 -> registros 8, 9, 10
L 0x47DB fase_programa  cada cuadro del programa: la pantalla en curso y los sprites a la VRAM
L 0x47DE sprites_a_vram  la copia de los atributos (0xD870) a 0x3B00, 128 bytes
L 0x47EB pantalla_en_curso  lee el teclado, cambia de pantalla con F1-F5 y SHIFT, y salta a la de 0xD8F4
C 0x47EB 0xD904: SYN en marcha, nada
C 0x47F0 la tecla
C 0x47F3 0xD901: cambiando de pantalla
C 0x47F9 SHIFT: la otra pagina del menu
C 0x47FC F1-F5: otra pantalla
C 0x47FF la pantalla
L 0x4817 tecla_de_la_matriz  la primera tecla pulsada como fila * 8 + bit + 1 en 0xD8F2; 0xD8F1 = la nueva; 0xD8F3 con repeticion
C 0x4817 solo con el programa en marcha
C 0x481D las filas 0 a 8
C 0x4826 una tecla en esta fila
C 0x482E ninguna: 0
C 0x4831 D = la fila
C 0x4836 C = bit + 1
C 0x483D fila * 8 + C
C 0x4842 0xD8F2: la de ahora
C 0x4848 la misma que antes:
C 0x484B no es nueva
C 0x484C 0xD8F1: la nueva
C 0x484E 0xD8FD: la que se repite y su cuenta
L 0x4851 repeticion  (HL + 2) = la tecla nueva o, tenida mas de 0x28 cuadros, la de ahora en cada cuadro
C 0x4853 nueva?
C 0x4858 la misma que se tenia...
C 0x485D ...mas de 0x28 cuadros:
C 0x4860 repite
C 0x4862 cuenta un cuadro
C 0x4866 otra tecla: la apunta y la cuenta a cero
L 0x486D cambio_de_pantalla  F1-F5 (0x36-0x3A) en 0xD8F1
L 0x4877 pantalla_por_tecla  A = codigo de F1-F5: la pantalla 0-4, o 5-8 en la segunda pagina del menu
C 0x4877 antes de F1...
C 0x487A ...o despues de F5: nada
C 0x487D 0 a 4
C 0x4880 la segunda pagina...
C 0x4886 ...suma 5, hasta la 8
C 0x488D 0xD8FB: la de antes
C 0x4893 0xD8F5: su estado
C 0x4899 0xD8F4: la nueva
C 0x489D estado 0
C 0x48A6 el efecto 5
L 0x48AC shift_cambia_menu  SHIFT (0x31) recien pulsada
L 0x48B2 cambia_menu  0xD8F0 pasa de 0 a 1 o de 1 a 0
L 0x48C4 pinta_menu  las dos filas de abajo (0x3AC0): el menu 0x8A41, o 0x8A81 en la segunda pagina
L 0x48D9 pantalla_syn  SYN: la cortina, el teclado, y 0xD8F6 = 2 para que el bucle principal sintetice (0x4BA1)
C 0x48D9 la cortina; M al acabar
C 0x48DD el rotulo de SYN (0x48F4)
C 0x48E3 sus sprites (0x4CD4) a la copia
C 0x48EE pide la sintesis
L 0x490B pantalla_play  PLAY: la primera vez prepara la pantalla; luego, si el programa esta en marcha, toca (0x5D3A)
C 0x490B 0xD8FA: estado de la pantalla
C 0x4918 a tocar
L 0x491B play_prepara  la cortina, el teclado y los sprites de PLAY (0x4946)
C 0x491F 0xB392
C 0x4922 los sprites
C 0x4931 estado 1
L 0x4936 cortina_y_teclado  la cortina de salida y, al acabar, la pantalla del teclado; M al acabar
C 0x4936 cambiando de pantalla
C 0x4939 una columna
C 0x493D la pantalla nueva
C 0x4940 ya no se esta cambiando
C 0x4943 M
L 0x494E pantalla_teclado  el teclado de PLAY y SYN, y en cada tecla el nombre de su timbre segun el LAYOUT (0xD200)
C 0x494E pantalla apagada
C 0x4951 lo comun
C 0x4954 patrones y colores del teclado
C 0x4978 (0x002C) de la BIOS: el juego de caracteres
C 0x497D japones (0): sin el dibujo de 0x97FD
C 0x4991 los nombres del teclado
C 0x4997 el LAYOUT, una entrada por tecla
C 0x499A las teclas 1 a 0x30
C 0x499F busca la entrada en 0xBCCA...
C 0x49A8 ...su indice a 0xD905
C 0x49AF la escribe en su tecla
C 0x49B5 la 0x16 no esta
C 0x49C0 pantalla encendida
L 0x49C4 fin_de_cambio  0xD901 = 0
L 0x49C7 empieza_cambio  0xD901 = 1
C 0x49CF el registro A del cargador: 6 bytes por entrada
C 0x49E1 origen, destino y longitud
C 0x49EE los dos bits altos de la longitud dicen como:
L 0x4A14 tecla_pulsada  la tecla 0xDC47 se pinta hundida en el teclado (0xD8F8 = 1)
L 0x4A22 tecla_soltada  la tecla 0xDC47 vuelve a su dibujo (0xD8F8 = 0)
C 0x4A2D su entrada del LAYOUT
C 0x4A31 ninguna: nada
C 0x4A33 0x13 o mas: tecla negra
C 0x4A3F direccion de VRAM
C 0x4A4E el puerto de escritura
C 0x4A58 soltada: el nombre otra vez
C 0x4A5E pulsada: lo tapa
C 0x4A64 y los sprites de la tecla en la copia
C 0x4A99 a la VRAM
C 0x4A9C tecla blanca: su sitio en 0x4B3F
C 0x4AA8 pulsada o suelta
L 0x4AC2 nombre_en_la_tecla  escribe en la tecla el nombre de su timbre, con el cartucho en la pagina 2 mientras tanto
C 0x4AC2 los graficos estan en el cartucho
C 0x4ACF su indice en 0xBCCA
C 0x4ADE la escribe
C 0x4AE1 la RAM otra vez
L 0x4AE4 tapa_nombre  tapa el nombre de la tecla con los tiles de 0x4B00 y 0x4B02
L 0x4B04 entrada_del_layout  HL = 0xD200 + tecla 0xDC47 - 1
L 0x4B0F vram_para_escribir  la direccion de escritura del VDP = HL
C 0x4B10 el puerto de control
C 0x4B19 bit 6: escritura
L 0x4B21 layout_de_fabrica  los 0x30 bytes de 0x4B71 al LAYOUT (0xD200)
L 0x4BA1 hace_syn  SYN pedido por la pantalla: copia el timbre en curso a 0xDC00, sintetiza y salta a la pantalla de la tecla que corto o acabo
C 0x4BA1 espera a que acabe el efecto del canal C
C 0x4BA7 0xD904: ocupado
C 0x4BAC HL = el timbre en curso
C 0x4BAF sus 25 bytes a 0xDC00
C 0x4BB7 la sintesis
C 0x4BBA borra las dos filas del menu
C 0x4BC4 la tecla que dejo SYN: F4 al acabar
C 0x4BCA todo a cero
C 0x4BD9 deja entrar interrupciones
C 0x4BDA 0xD907: cuenta de tics
C 0x4BF6 dos cambios en la VRAM de la tabla 0x4C61
C 0x4C00 direccion
C 0x4C0F dos bytes
C 0x4C1A un tic mas
C 0x4C28 el sprite avanza en X...
C 0x4C2D ...hasta 0x98
C 0x4C37 cada dos tics...
C 0x4C3B ...el dibujo siguiente de tres
C 0x4C43 los patrones de 0x4C5B
C 0x4C8B parpadeo: 0x4CE4 o 0x4CF4
C 0x4C91 0x14 veces
C 0x4CA7 0xD902
C 0x4CAB borra dos tiles en 0x3AD4...
C 0x4CB4 ...y en 0x3AF4
C 0x4CC5 cada 8 tics...
C 0x4CCD ...cambia el dibujo

# ----------------------------------------------------------------------
# FILE: CINTA Y DISCO (tanda 5)
# 0xDB18 = el tipo: 0x21 TONE (0xC000), 0x22 LAYOUT (0xD200), 0x23 SAMP
# (0x8000); 0xDB0F = el nombre, 7 letras en el codigo de la fuente (0x21 = A).
# En cinta: cabecera larga con 16 veces el tipo, el nombre, la longitud
# (+ la pagina de bucle en SAMP) y los datos, cada bloque tras su cabecera.
# En disco: NOMBRE.T, .K o .S (0x51D8) por la BDOS del Disk BASIC (0xF37D).
# ----------------------------------------------------------------------
L 0x4D04 graba_en_cinta  graba el fichero del tipo 0xDB18 en cinta
C 0x4D04 la RAM en la pagina 2
C 0x4D08 cabecera larga
C 0x4D0F 0xDBF0 = la direccion de los datos
C 0x4D15 16 veces el tipo
C 0x4D1F cabecera corta...
C 0x4D25 ...y las 7 letras del nombre
C 0x4D31 cabecera corta...
C 0x4D37 ...y la longitud, 0xDCFE
C 0x4D43 BC = la longitud
C 0x4D47 SAMP: tambien la pagina de bucle
C 0x4D55 cabecera corta...
C 0x4D5C ...y los datos
C 0x4D6B una pausa
C 0x4D70 fin de la grabacion
C 0x4D73 el cartucho otra vez
L 0x4D78 error_de_cinta  para el motor, vuelve el cartucho y sale con acarreo
L 0x4D82 byte_a_cinta  TAPOUT de A
L 0x4D8A busca_otra_vez  otro fichero en la cinta
L 0x4D8C carga_de_cinta  busca en la cinta un fichero del tipo 0xDB18 (y del nombre de 0xDB0F, si lo hay) y lo carga
C 0x4D8C la RAM en la pagina 2
C 0x4D93 SAMP: el sample en blanco antes
C 0x4D9A una cabecera
C 0x4D9F 16 bytes, todos del tipo
C 0x4DAB otro tipo: a buscar otra vez
C 0x4DAF el nombre todo espacios...
C 0x4DBD ...vale cualquiera (C = 1)
C 0x4DC0 la cabecera del nombre
C 0x4DCB 7 letras
C 0x4DD0 cualquiera, o...
C 0x4DD4 ...la misma
C 0x4DD7 se queda con la que llega
C 0x4DDB el cartucho, para escribir en pantalla
C 0x4DE1 "FOUND"...
C 0x4DE7 ...y el nombre
C 0x4DF3 la cabecera de la longitud
C 0x4DF9 0xDCFE
C 0x4E08 SAMP: la pagina de bucle
C 0x4E18 la cabecera de los datos
C 0x4E1E 0xDBF0 = su direccion
C 0x4E21 BC = la longitud
C 0x4E2A los datos
C 0x4E37 una pausa
C 0x4E3C fin de la lectura
C 0x4E44 0x80 desde 0x8000...
C 0x4E47 ...0x3FFF bytes mas
L 0x4E52 byte_de_cinta  TAPIN a A; acarreo si falla
L 0x4E5A direccion_de_carga  0xDBF0 = la direccion del tipo 0xDB18 (0x4E7A)
C 0x4E5A el tipo, de 0 a 2...
C 0x4E5F ...por dos
L 0x4E6F pausa  B vueltas de 65536
L 0x4E89 graba_en_disco  NOMBRE.ext con la longitud (y el bucle en SAMP) delante de los datos
C 0x4E89 para volver si hay error (0x5119)
C 0x4E90 la RAM en la pagina 2
C 0x4E93 el FCB en 0xD980
C 0x4E9C crea el fichero
C 0x4EA2 la longitud, 2 bytes
C 0x4EAF SAMP: la pagina de bucle
C 0x4EB8 la direccion de los datos...
C 0x4EBC ...a la DMA
C 0x4EC1 los datos, de un tiron
C 0x4EC7 cierra
L 0x4ED1 carga_de_disco  abre NOMBRE.ext, lee la longitud (y el bucle) y los datos
C 0x4EEB SAMP: el sample en blanco antes
C 0x4EEE abre
C 0x4EF4 la longitud
C 0x4F01 SAMP: la pagina de bucle
C 0x4F0A la DMA
C 0x4F13 los datos
C 0x4F19 cierra
L 0x4F23 borra_de_disco  borra NOMBRE.ext
C 0x4F39 BDOS 0x13: borrar
C 0x4F44 error 1
L 0x4F4D directorio  busca los ficheros del tipo 0xDB18: hasta 0x23 nombres en 0xD2E1, 11 bytes cada uno
C 0x4F57 la lista, a espacios
C 0x4F64 un FCB...
C 0x4F71 ...con ???????? de nombre
C 0x4F7E ninguno todavia
C 0x4F85 la DMA en 0xD2C0
C 0x4F8D BDOS 0x11: el primero
C 0x4F98 la letra de la extension del tipo...
C 0x4F9E ...y dos espacios detras
C 0x4FAB uno mas
C 0x4FB0 a la lista
C 0x4FB5 0x23: no caben mas
C 0x4FB9 BDOS 0x12: el siguiente
C 0x4FC4 "END" si hay alguno...
C 0x4FCE ...o "NO FILE"
C 0x4FD7 el efecto 2
L 0x4FF4 directorio_teclas  arriba y abajo mueven la lista de diez; RETURN (0x40) sale con acarreo
C 0x4FF7 el byte de teclas con repeticion
C 0x4FFD 1: arriba
C 0x5001 2: abajo
C 0x5005 RETURN
C 0x5011 sube si no esta arriba
C 0x501A baja si quedan mas de diez
L 0x502F cambiando_pantalla  0xD901 = 1
L 0x5033 pantalla_quieta  0xD901 = 0
L 0x5038 lista_de_diez  diez nombres desde el 0xD9B6, uno por fila desde 0x38E8
C 0x5043 la entrada C
C 0x5047 a la pantalla
C 0x504B la fila siguiente
L 0x5058 un_nombre  escribe un nombre de la lista, con su punto, o la marca de fin
C 0x505E vacia: nada
C 0x5061 0x96: el final
C 0x5065 0x40: "END"
C 0x5069 7 letras...
C 0x506E ...el punto...
C 0x5074 ...y 3 mas
L 0x5086 letras_a_vram  B caracteres ASCII de DE a la VRAM de HL, convertidos a tiles
C 0x508B espacio y @: tile 0
C 0x5097 cifras: + 0x10
C 0x509F letras: - 0x20
L 0x50A9 al_directorio  la entrada 0xD2C1 del FCB encontrado a la lista
L 0x50B0 copia_entrada  11 bytes de DE a la entrada A de la lista
L 0x50BA entrada_de_la_lista  HL = 0xD2E1 + 11 * A
C 0x50BF A * 3...
C 0x50C1 ...* 4 - A = A * 11
L 0x50CB entrada_en_de  DE = 0xD2E1 + 11 * A
L 0x50DE error_de_disco  el codigo de error de la BIOS del disco (C) a uno de los mensajes
L 0x50F7 mensaje_de_error  el mensaje C de 0x511F en 0x3A06, y vuelve por la pila guardada en 0xD972 con acarreo
C 0x50F8 el cartucho para la pantalla
C 0x5107 el mensaje
C 0x5116 0xB8F8
C 0x5119 la pila de antes de la operacion
L 0x5191 fcb  arma el FCB en DE con el nombre 0xDB0F (los tiles a ASCII) y la letra del tipo
C 0x5191 nombre todo espacios o con huecos: error 6
C 0x519D unidad 0: la de siempre
C 0x51A0 7 letras
C 0x51A3 tiles 0x21-0x3F: letras, + 0x20
C 0x51AB 0x40 en adelante: cifras, - 0x10
C 0x51B2 la octava, un espacio
C 0x51B6 la extension: T, K o S...
C 0x51BB ...y dos espacios
C 0x51C3 el resto del FCB a cero
L 0x51CB letra_del_tipo  A = T, K o S segun 0xDB18
L 0x51DB nombre_valido  acarreo si el nombre empieza por espacio o tiene un hueco entre letras
L 0x520A fcb_hl  0xD970 = HL
L 0x520D fcb_a_cero  bloque 0, registro de 1 byte y registro aleatorio 0
C 0x5210 bloque actual = 0
C 0x5218 tamano de registro = 1
C 0x5222 el registro aleatorio a cero
L 0x522A registro_aleatorio  (FCB + 0x21) = HL, con el FCB en DE
L 0x523D abre  BDOS 0x0F; error 1
L 0x5248 si_falla  A = 0xFF: el mensaje de error C
L 0x524D crea  BDOS 0x16; error 5
L 0x525A cierra  BDOS 0x10; error 2
L 0x5267 lee_bloque  BDOS 0x27, HL registros; error 0
L 0x5272 si_no_cero  A distinto de 0: el mensaje de error C
L 0x5277 escribe_bloque  BDOS 0x26, HL registros; error 2
L 0x5284 lee_byte  un byte del fichero a A, por la pila
L 0x5289 escribe_byte  A al fichero, por la pila
C 0x528C A en la pila...
C 0x5292 ...es la DMA
L 0x529E un_registro  HL = 1 y salta a BC
L 0x52A3 escribe_palabra  HL al fichero, el bajo primero
L 0x52AC lee_palabra  HL del fichero
L 0x52B7 pantalla_imprime  la pantalla 7: imprime y vuelve a la pantalla de antes
C 0x52BC espera a la impresora; acarreo si no esta
C 0x52C1 desde WAVE EDIT...
C 0x52C6 ...la onda
C 0x52C9 y lo demas
C 0x52CC vuelve a la pantalla de antes
L 0x52D9 impresora_lista  espera a que la impresora este lista y empieza
C 0x52D9 la pila, para salir si falla
C 0x52E2 RAWPRT = 1: sin traducir los codigos
L 0x52ED espera_impresora  LPTSTT hasta que conteste, con limite
C 0x52F3 lista?
C 0x52F8 0xFF: no hay

# ----------------------------------------------------------------------
# LA IMPRESORA (tanda 6): la pantalla 7 vuelca la pantalla en puntos por
# LPTOUT; desde WAVE EDIT, ademas, la tabla de la onda en cifras.
# 0xD930: 0x70/0x71/0x72, el modo; 0xD938 = 1 si la impresora falla.
# ----------------------------------------------------------------------
C 0x52FD 256 x 256 x H intentos
L 0x5305 impresora_falla  manda 0x200 ceros y ocho saltos de linea, y vuelve por la pila guardada con acarreo
C 0x5309 0x200 ceros
C 0x531C 8 veces CR + LF
L 0x532E sale_de_imprimir  la pila de 0xD931 y acarreo
L 0x5334 no_hay_impresora  el rotulo de 0x534D, una espera y el menu otra vez
C 0x533A la espera, 15 x 65536 vueltas
L 0x5361 imprime  A a la impresora en cuanto este lista; 0xD938 = 1 si falla
C 0x5368 espera...
C 0x536D ...a 0xFF
C 0x5372 LPTOUT
L 0x5383 cuatro_lineas  cuatro veces CR + LF
L 0x538B nueva_linea  CR + LF
L 0x5395 punto_con_tinta  A distinto de 0 si el punto de 0xD933 lleva tinta
L 0x539E comparar_color  0 si el color es 4
L 0x53A9 color_del_punto  el color del punto (X, Y) de 0xD933 en SCREEN 2: el tile de la tabla de nombres, su patron y su color
C 0x53A9 la direccion de su nombre
C 0x53AF el tile...
C 0x53B2 ...por 8...
C 0x53B8 ...mas la linea dentro del tile
C 0x53C3 y el tercio de la pantalla
C 0x53D8 el bit del punto
C 0x53DE en los patrones (0x2000)
C 0x53E9 al acarreo
C 0x53EE y el color (0x0000)
C 0x53F7 bit a 1: la tinta (nibble alto)...
C 0x53F9 ...a 0: el fondo (bajo)
L 0x5405 nombre_del_punto  HL = 0x3800 + (Y / 8) * 32 + X / 8
L 0x5419 vuelca_pantalla  la pantalla en puntos: 0x40 franjas de cuatro filas, 0xC0 columnas cada una
C 0x5419 la secuencia de arranque (0x54B6)
C 0x541C 0x40 franjas
C 0x5421 la secuencia de cada franja: 0x54BD o 0x54C4
C 0x5431 0xC0 columnas
C 0x5437 el punto de arriba de la columna
C 0x543A dos bytes que se arman en 0xD935
C 0x5445 cuatro puntos, dos bits cada uno
C 0x5449 el color del punto...
C 0x544C ...a su trama de 0x54F6
C 0x5450 los dos bits de este punto
C 0x5460 los dos siguientes
C 0x5464 el punto de debajo
C 0x546D los dos bytes a la impresora
C 0x5483 fin de la franja
C 0x5486 si fallo, a 0x5305
C 0x548D la franja siguiente
L 0x5499 segundo_byte  en el modo 0x72 cada byte va dos veces
L 0x54A4 secuencia_54cb  la secuencia de 0x54CB
L 0x54A9 secuencia_inicial  la secuencia de 0x54B6
L 0x54AC imprime_lista  los bytes de DE hasta 0xFF
L 0x54E9 trama  DE = la trama del color A (0x54F6)
L 0x5516 imprime_onda  desde WAVE EDIT: cabecera, columnas del 0 al 7 y 8 filas de 8 muestras, una de cada cuatro, con signo y tres cifras
C 0x5519 los rotulos de 0x54D2...
C 0x5524 ...y 0x54DA
C 0x5532 las cifras 0 a 7 de las columnas
C 0x5544 0x54D5
C 0x554D una raya de 0x3A guiones
C 0x5559 HL = la onda
C 0x555D 8 filas
C 0x5565 8 muestras
C 0x5568 la muestra
C 0x556C negativa: el guion y su valor absoluto
C 0x557B a decimal (0xA978)
C 0x557E las tres cifras en 0xDBF0
C 0x5593 en ASCII, la alta primero
C 0x55A4 cuatro muestras mas alla
L 0x55B4 espacios  B espacios
L 0x55BC timbres_y_ondas_de_fabrica  los 16 timbres de 0xA3AA a 0xD000, la tabla de teclas y las 16 ondas del usuario como el seno de 0x7200
C 0x55BC 16 timbres de 32 bytes
C 0x55C7 la tabla de teclas
C 0x55CA las 16 ondas...
C 0x55D0 ...todas el seno de 0x7200
L 0x55DC teclas_de_fabrica  los 0x80 bytes de 0x5DA9 a 0xD230: rutina y retardo de cada tecla
L 0x5F56 con_bucle_02  rutina 2 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x5FF4 con_bucle_03  rutina 3 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x60A2 con_bucle_04  rutina 4 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x6150 con_bucle_05  rutina 5 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x61E5 con_bucle_06  rutina 6 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x628B con_bucle_07  rutina 7 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x6339 con_bucle_08  rutina 8 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x63D6 con_bucle_09  rutina 9 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x6473 con_bucle_10  rutina 10 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x6510 con_bucle_11  rutina 11 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x65AD con_bucle_12  rutina 12 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x6652 con_bucle_13  rutina 13 de 0x5E8B: como 0x5EC9, con otro relleno de ciclos
L 0x67C2 sin_bucle_02  rutina 2 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6850 sin_bucle_03  rutina 3 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x68EC sin_bucle_04  rutina 4 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6988 sin_bucle_05  rutina 5 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6A0E sin_bucle_06  rutina 6 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6AA3 sin_bucle_07  rutina 7 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6B3F sin_bucle_08  rutina 8 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6BCC sin_bucle_09  rutina 9 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6C59 sin_bucle_10  rutina 10 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6CE6 sin_bucle_11  rutina 11 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6D73 sin_bucle_12  rutina 12 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6E07 sin_bucle_13  rutina 13 de 0x6709: como 0x6743, con otro relleno de ciclos
L 0x6F40 escucha_02  rutina 2 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x6F69 escucha_03  rutina 3 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x6F96 escucha_04  rutina 4 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x6FC3 escucha_05  rutina 5 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x6FE9 escucha_06  rutina 6 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x7014 escucha_07  rutina 7 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x7041 escucha_08  rutina 8 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x7069 escucha_09  rutina 9 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x7091 escucha_10  rutina 10 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x70B9 escucha_11  rutina 11 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x70E1 escucha_12  rutina 12 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
L 0x710B escucha_13  rutina 13 de 0x6EBB: como 0x6F1C, con otro relleno de ciclos
# ----------------------------------------------------------------------
# PLAY (tanda 7): una sola tecla suena cada vez. Cada tecla de la matriz
# tiene en 0xD230 (0x5DA9) una de 13 rutinas y un retardo D: la rutina pone
# el relleno de ciclos fijo de cada muestra y D el bucle de espera; entre
# los dos dan la altura de la nota. Las muestras salen de 0x8000 al DAC.
# Con pagina de bucle (0xDCFD) la tabla es 0x5E8B: suena hasta esa pagina,
# la repite mientras se tiene la tecla y al soltarla sigue hasta 0xC000.
# Sin bucle, 0x6709: suena de corrido hasta 0xC000. Mientras suena la cola
# se mira el teclado fila a fila: otra tecla empieza otra nota.
# ----------------------------------------------------------------------
L 0x5D45 busca_tecla  recorre las filas 0 a 7 hasta una con alguna tecla pulsada: NZ y A = la fila + 1; Z si no hay ninguna
C 0x5D45 desde la fila 0
C 0x5D4B alguna pulsada en esta fila?
C 0x5D4F la fila siguiente
C 0x5D56 hasta la 7
L 0x5D5D codigo_de_tecla  0xDC47 = fila * 8 + bit + 1 de la tecla; C = la mascara de su bit
C 0x5D5E el DAC al reposo
C 0x5D64 la fila menos uno...
C 0x5D66 ...negada: el bit de la tecla
C 0x5D69 E = el numero del bit
C 0x5D71 la fila
C 0x5D7D el codigo
L 0x5D81 rutina_de_la_tecla  A = su rutina y D = su retardo (0xD22E + 2 * codigo); Z si la tecla no tiene nota (0xFF)
L 0x5D90 pinta_tecla_pulsada  0x4A14 guardando los registros
L 0x5D9A rutina_en_ix  IX = la palabra A de la tabla HL
L 0x5EA5 play_con_bucle  PLAY con pagina de bucle: espera tecla y toca con la tabla 0x5E8B
C 0x5EA5 ninguna tecla: vuelve
L 0x5EA9 nota_con_bucle  la nota de la tecla pulsada
C 0x5EA9 0xDC47 y la mascara
C 0x5EAC su rutina y su retardo
C 0x5EB0 la tecla hundida en pantalla
C 0x5EB3 IX = la rutina
C 0x5EBB la RAM del sample
C 0x5EC0 desde 0x8000...
C 0x5EC3 ...hasta la pagina de bucle (E)
C 0x5EC7 a la rutina
L 0x5EC9 con_bucle_01  rutina 1 de 0x5E8B: hasta la pagina de bucle; en ella mientras se tiene la tecla; al soltar, hasta 0xC000 mirando si hay otra
L 0x5EEC con_bucle_01_repite  la pagina de bucle una y otra vez mientras la tecla sigue pulsada
L 0x5EFD con_bucle_01_suelta  tecla suelta: acaba la pagina en curso
L 0x5F0F con_bucle_01_cola  el resto del sample hasta 0xC000, mirando una fila del teclado cada cuatro muestras
L 0x66F7 fin_de_nota  la tecla vuelve a su dibujo y el cartucho a la pagina 2
L 0x66FE otra_nota_con_bucle  otra tecla pulsada durante la cola: la nota nueva
L 0x6723 play_sin_bucle  PLAY sin pagina de bucle: espera tecla y toca con la tabla 0x6709
L 0x6727 nota_sin_bucle  la nota de la tecla pulsada
C 0x673E desde 0x8000
L 0x6743 sin_bucle_01  rutina 1 de 0x6709: de corrido hasta 0xC000; al soltar, mirando si hay otra tecla
L 0x6769 sin_bucle_01_suelta  tecla suelta: acaba la pagina en curso
L 0x677B sin_bucle_01_cola  el resto hasta 0xC000, mirando el teclado
L 0x6E9B fin_de_nota_sin_bucle  la tecla vuelve a su dibujo y el cartucho a la pagina 2
L 0x6EA2 otra_nota_sin_bucle  otra tecla durante la cola: la nota nueva
L 0x6EAD final_del_sample  el DAC al reposo y espera a que no haya ninguna tecla
L 0x6ED5 escucha_onda  WAVE EDIT: la onda del usuario, con el paso de FEET, en 0xDD00, y suena en bucle mientras se tiene la tecla 0xDC47
C 0x6ED6 destino 0xDD00
C 0x6ED9 la onda del usuario 0xDB00...
C 0x6EDE ...en 0xC000 + 0x100 * onda
C 0x6EE0 el paso: FEET (0xDC01)
C 0x6EE4 la muestra...
C 0x6EE5 ...sin signo...
C 0x6EE7 ...a 0xDD00
C 0x6EE8 la fase avanza FEET
C 0x6EEF la fila y el bit de la tecla 0xDC47
C 0x6EF9 C = la mascara del bit
C 0x6F00 su rutina y su retardo
C 0x6F07 la rutina de 0x6EBB
C 0x6F0D la pagina 0xDD
C 0x6F14 el DAC al reposo
L 0x6F1A salta_ix  `jp (ix)`
L 0x6F1C escucha_01  rutina 1 de 0x6EBB: la pagina 0xDD una y otra vez mientras se tiene la tecla
