C 0x566A el DCO...
C 0x566D ...contra la mayor de las otras
C 0x5672 el DCO es mayor
C 0x5677 + 0x1FF...
C 0x567B ...y la pagina entera
C 0x5681 E = S del DCA
C 0x5682 C = R del DCA
C 0x5686 HL = S * R
C 0x568A mas lo anterior
C 0x568F 16 KB o mas?
